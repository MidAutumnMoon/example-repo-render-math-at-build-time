{
    "name": "try-render",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --config vite.prerender.config.ts && node dist-prerender/main.js",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check ."
    },
    "devDependencies": {
        "@babel/core": "^7.23.3",
        "@babel/types": "^7.23.3",
        "@types/babel__core": "^7.20.4",
        "@types/node": "^24.0.0",
        "happy-dom": "^20.0.0",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "solid-js": "^1.9.0",
        "temml": "^0.14.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.9.0"
}
